---
import { type CardListIcon } from "@/interfaces/CardListIcon.ts";
import CardIcon from "./CardIcon.astro";
import "@styles/components/Cards.scss";

interface Props {
    cardListIcon: CardListIcon[];
}

const { cardListIcon } = Astro.props;
---

<div class="card-grid card-list-wrapper">
    {
        cardListIcon.map((item) => (
            <CardIcon img={item.img} classIcon={item.classIcon} title={item.title} description={item.description} buttonText={item.buttonText} fullDescription={item.fullDescription} technologies={item.technologies}></CardIcon>
        ))
    }
</div>