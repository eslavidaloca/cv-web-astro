---
import "@styles/components/layout/Header.scss";
import { cn } from "@/lib/utils";

type Props = {
  className?: string;
};

const { className } = Astro.props;
---

<header
  class={cn(
    "flex items-center h-16 md:h-18 z-50 sticky top-0 bg-background navbar px-5",
    className
  )}
>
  <div class="flex items-center justify-between w-full gap-2">
    <div class="header-left">
      <a href="/" class="flex items-center gap-1 shrink-0">
        <span class="hidden font-bold lg:inline-block">Jonathan</span>
        <span class="text-green-700 dark:text-green-500 font-bold inline-block">Eslavi</span>
        <span class="hidden font-bold lg:inline-block">Medina</span>
        <span class="hidden font-bold lg:inline-block">Dávila</span>
      </a>
      <span class="header-role hidden lg:inline m-0">Fullstack Developer</span>

      <div class="hidden lg:flex">
        <slot name="left-header" />
      </div>
    </div>

    <div class="header-mid hidden lg:flex">
      <slot name="mid-header" />
    </div>

    <div class="header-right">
      <div class="header-desktop-actions hidden lg:flex">
        <slot name="right-header" />
      </div>
      <div class="header-mobile-actions flex lg:hidden">
        <slot name="mobile-nav-header" />
      </div>
    </div>
  </div>
</header>
