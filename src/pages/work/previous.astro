---
import Layout from '@/layouts/Layout.astro';
import { Icon } from "astro-icon/components";
import CardListIcon from '@/components/CardListIcon.astro';
import "@styles/components/Cards.scss";

import { cardListIcon } from "@/data/pages/work/previousWork-data";
---
<Layout>
	<div class="page-card page-card--wide">
		<div class="page-card-inner">
			<div class="page-card-intro">
				<div class="work-hero pb-10">
					<button class="transition md:hover:scale-105 shrink-0">
						<span class="cursor-(--cursorPointer) inline-flex p-2">
							<a href="https://administracion.jalisco.gob.mx/" target="_blank">
								<Icon name="work/ibm" class="size-20 sm:size-[120px] text-blue-500" />
							</a>
						</span>
					</button>
					<div class="font-bold text-3xl 2xl:text-2xl">
						My previous work experience was <span class="text-green-700 dark:text-green-500">@</span> IBM
					</div>
				</div>
				<div class="text-slate-dark-900 dark:text-mauve-900 text-xl/8 2xl:text-2xl/9 text-wrap">
					Worked here for one year as a intern Fullstack Developer.
					<p>Was on charged of one of the modules of a big project they had to perform various tasks in the financial sector of the company.</p>
				</div>
			</div>
			<div class="work-projects flex flex-col text-slate-dark-900 dark:text-mauve-900 text-xl/8 2xl:text-2xl/9 text-wrap">
				<span class="font-bold text-green-700 dark:text-green-500 mb-4">Some of these projects are:</span>
				<CardListIcon cardListIcon={cardListIcon} />
			</div>
		</div>
	</div>
</Layout>
