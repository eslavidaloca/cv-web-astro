---
import Layout from '@/layouts/Layout.astro';
import { Picture } from 'astro:assets';
import CardList from '@/components/CardList.astro';
import "@styles/components/Cards.scss";

const currentWorkImg = "/isologo_headerfoot.webp";

import { cardList } from "@/data/pages/work/currentWork-data";
---
<Layout>
	<div class="page-card page-card--wide">
		<div class="page-card-inner">
			<div class="page-card-intro">
				<div class="work-hero pb-10">
					<button class="transition md:hover:scale-105 shrink-0">
						<span class="cursor-(--cursorPointer) inline-flex p-2">
							<a href="https://administracion.jalisco.gob.mx/" target="_blank">
								<Picture src={currentWorkImg} alt="Current work logo" width={350} height={100} class="work-hero-logo"/>
							</a>
						</span>
					</button>
					<div class="font-bold text-3xl 2xl:text-2xl">
						Currently working <span class="text-green-700 dark:text-green-500">@</span> Secretary of Administration
					</div>
				</div>
				<div class="text-slate-dark-900 dark:text-mauve-900 text-xl/8 2xl:text-2xl/9 text-wrap">
					Have worked here for about 2 years now, as a Fullstack Developer mainly focused on the frontend.
					<p>Over the years, I have had the opportunity to work on a wide range of projects, from small to large, and I have learned a lot from them.</p>
				</div>
			</div>
			<div class="work-projects flex flex-col text-slate-dark-900 dark:text-mauve-900 text-xl/8 2xl:text-2xl/9 text-wrap">
				<span class="font-bold text-green-700 dark:text-green-500 mb-4">Some of these projects are:</span>
				<CardList cardList={cardList} />
			</div>
		</div>
	</div>
</Layout>
