---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Reveal from "@/components/skills/frontend/Reveal";
import DeployTerminal from "@/components/skills/deploy/DeployTerminal";
import { deployPageEn } from "@/data/pages/skills/deploy-page";
import "@styles/pages/skills-deploy.scss";

const page = deployPageEn;
---

<Layout>
	<article class="skills-deploy">
		<section class="skills-deploy-hero" aria-labelledby="deploy-hero-title">
			<div class="skills-deploy-hero-copy">
				<h1 id="deploy-hero-title" class="skills-deploy-hero-title">
					{page.hero.headline}{" "}
					<span class="skills-deploy-hero-accent">{page.hero.headlineAccent}</span>
				</h1>
				<p class="skills-deploy-hero-sub">{page.hero.subtext}</p>
				<div class="skills-deploy-hero-actions">
					<a class="skills-deploy-cta-primary" href={page.hero.primaryCta.href}>
						{page.hero.primaryCta.label}
					</a>
					<a
						class="skills-deploy-cta-secondary"
						href={page.hero.secondaryCta.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						{page.hero.secondaryCta.label}
					</a>
				</div>
			</div>
			<div class="skills-deploy-hero-visual">
				<DeployTerminal client:visible lines={page.terminal.lines} />
			</div>
		</section>

		<section class="skills-deploy-section" aria-labelledby="deploy-proof-title">
			<h2 id="deploy-proof-title" class="skills-deploy-section-title">
				{page.proof.headline}
			</h2>
			<p class="skills-deploy-section-sub">{page.proof.subtext}</p>
			<Reveal client:visible>
				<div class="skills-deploy-proof">
					{
						page.proof.stats.map((stat) => (
							<div class="skills-deploy-proof-stat">
								<div class="skills-deploy-proof-value">{stat.value}</div>
								<div class="skills-deploy-proof-label">{stat.label}</div>
								<p class="skills-deploy-proof-detail">{stat.detail}</p>
							</div>
						))
					}
					<div class="skills-deploy-proof-image">
						<img
							src="/deploy-hero.webp"
							alt={page.proof.imageAlt}
							width="1600"
							height="900"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</Reveal>
		</section>

		<section class="skills-deploy-section" aria-labelledby="deploy-stack-title">
			<h2 id="deploy-stack-title" class="skills-deploy-section-title">
				{page.stack.headline}
			</h2>
			<p class="skills-deploy-section-sub">{page.stack.subtext}</p>
			<div class="skills-deploy-stack">
				{
					page.stack.groups.map((group) => (
						<div class="skills-deploy-stack-group">
							<h3>{group.name}</h3>
							<ul class="skills-deploy-stack-list">
								{group.items.map((item) => (
									<li class="skills-deploy-stack-chip">
										{item.local ? (
											<Icon name={item.local} class="skills-deploy-stack-icon" aria-hidden="true" />
										) : (
											<img
												src={`https://cdn.simpleicons.org/${item.icon}`}
												alt=""
												width="18"
												height="18"
												loading="lazy"
												decoding="async"
											/>
										)}
										{item.title}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="skills-deploy-section" aria-labelledby="deploy-cases-title">
			<h2 id="deploy-cases-title" class="skills-deploy-section-title">
				{page.cases.headline}
			</h2>
			<ol class="skills-deploy-rail">
				{
					page.cases.items.map((item, index) => (
						<li class={`skills-deploy-rail-item skills-deploy-rail-item--${item.id}`}>
							<Reveal client:visible delay={index * 0.05} className="skills-deploy-rail-reveal">
								<div class="skills-deploy-rail-track" aria-hidden="true">
									<span class="skills-deploy-rail-dot"></span>
									<span class="skills-deploy-rail-line"></span>
								</div>
								<article class="skills-deploy-case">
									<span class="skills-deploy-case-stage">{item.stage}</span>
									<span class="skills-deploy-case-highlight">{item.highlight}</span>
									<h3 class="skills-deploy-case-title">{item.title}</h3>
									<p class="skills-deploy-case-text">{item.body}</p>
								</article>
							</Reveal>
						</li>
					))
				}
			</ol>
		</section>

		<section class="skills-deploy-section" aria-labelledby="deploy-cta-title">
			<div class="skills-deploy-cta-band">
				<h2 id="deploy-cta-title" class="skills-deploy-section-title">
					{page.cta.headline}
				</h2>
				<p class="skills-deploy-section-sub" style="margin-bottom: 1.25rem;">
					{page.cta.body}
				</p>
				<a
					class="skills-deploy-cta-primary"
					href={page.cta.primary.href}
					target="_blank"
					rel="noopener noreferrer"
				>
					{page.cta.primary.label}
				</a>
				<ul class="skills-deploy-cta-links">
					{
						page.cta.links.map((link) => (
							<li>
								<a
									href={link.href}
									target={link.href.startsWith("http") ? "_blank" : undefined}
									rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</article>
</Layout>
