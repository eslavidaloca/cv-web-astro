---
import Layout from '@/layouts/Layout.astro';
import Carousel from '@/components/Carousel.astro';

import { skills as frontendSkills } from '@/data/pages/skills/frontend-skills';
import Fireflies from '@/components/Fireflies.astro';
import Rain from '@/components/Rain.astro';
import { isDarkMode } from "@/nanostores.ts";
import "@styles/pages/skills-frontend.scss";

let isDark: boolean = false;


isDarkMode.subscribe(isDarkTheme => {
	if (isDarkTheme === "dark") {
		isDark = true;
	} else {
		isDark = false;
	}
	console.log(`isDark: ${isDark}`);
});
---
<Layout>
	{!isDark && <Rain />}
	{isDark && <Fireflies />}
	<div class="perspective-distant place-items-center skills-frontend-hero">
		<img src="/asking.webp" class="skills-frontend-image" alt="">
		<div class="container">
			<div class="boldFont skills-frontend-text">
				<div class="animate__animated animate__fadeInLeftBig">Sometimes...</div>
				<div class="animate__animated animate__fadeInBottomRight">your website can look</div>
				<div class="animate__animated animate__slideInUp">a little bit fuzzy</div>
				<Carousel itemsList={frontendSkills} />
			</div>
		</div>
	</div>
	<div class="container content-width p-4 mt-10 text-center">
		<span>In case you are wondering. This page isn't over, I'll still add more things, sorry for the delay</span>
	</div>
</Layout>